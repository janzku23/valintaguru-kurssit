# Existing variable names: never put service-role/Paytrail/Resend keys into NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
VALINTAGURU_ADMIN_EMAIL=admin@valintaguru.fi

# Official PUBLIC sandbox credentials; these are NOT real merchant credentials.
PAYTRAIL_MERCHANT_ID=375917
PAYTRAIL_SECRET_KEY=SAIPPUAKAUPPIAS
PAYTRAIL_MODE=test

# Supabase project reference must match both the URL and shop_environment row.
SHOP_SUPABASE_PROJECT_REF=
# Generate independent random server secrets (at least 32 chars). Do not expose to the client.
SHOP_INTERNAL_SECRET=
CRON_SECRET=

# Real money remains disabled until explicitly enabled by the owner after E2E verification.
SHOP_LIVE_ENABLED=false
SHOP_LEGAL_REVIEWED=false

# Public seller information, required before live checkout; use the actual company address.
SHOP_SELLER_POSTAL_ADDRESS="Purolantie 3, 65300 Vaasa"
